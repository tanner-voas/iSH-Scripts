diff --git a/.github/workflows/deploy-worker.yml b/.github/workflows/deploy-worker.yml
new file mode 100644
index 0000000..4099cd4
--- /dev/null
+++ b/.github/workflows/deploy-worker.yml
@@ -0,0 +1,40 @@
+name: Deploy PWA Profiles Worker
+
+on:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: deploy-pwa-profiles-api
+  cancel-in-progress: false
+
+jobs:
+  deploy:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Check out shared repository
+        uses: actions/checkout@v4
+      - name: Set up Node.js
+        uses: actions/setup-node@v4
+        with:
+          node-version: '22'
+      - name: Validate shared library and Worker
+        run: npm test && npm run check
+      - name: Deploy Worker with encrypted secrets
+        uses: cloudflare/wrangler-action@v4
+        with:
+          apiToken: ${{ secrets.CLOUDFLARE_API_TOKEN }}
+          accountId: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
+          wranglerVersion: '4'
+          secrets: |
+            GOOGLE_CLIENT_ID
+            GOOGLE_CLIENT_SECRET
+            SESSION_SIGNING_KEY
+            VAULT_KEY
+        env:
+          GOOGLE_CLIENT_ID: ${{ secrets.GOOGLE_CLIENT_ID }}
+          GOOGLE_CLIENT_SECRET: ${{ secrets.GOOGLE_CLIENT_SECRET }}
+          SESSION_SIGNING_KEY: ${{ secrets.SESSION_SIGNING_KEY }}
+          VAULT_KEY: ${{ secrets.VAULT_KEY }}
diff --git a/README.md b/README.md
