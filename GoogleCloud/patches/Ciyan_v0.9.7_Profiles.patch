+name: Update PWA Google Drive submodule
+on:
+  repository_dispatch:
+    types: [google-drive-release]
+  workflow_dispatch:
+permissions:
+  contents: write
+concurrency:
+  group: ciyan-shared-dependency
+  cancel-in-progress: false
+jobs:
+  advance-shared:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          submodules: true
+      - name: Advance shared library (latest main wins)
+        env:
+          REQUESTED_SHA: ${{ github.event.client_payload.sha }}
+        shell: bash
+        run: |
+          set -euo pipefail
+          git -C shared/google-drive fetch origin main
+          LATEST="$(git -C shared/google-drive rev-parse FETCH_HEAD)"
+          if [[ -n "$REQUESTED_SHA" && "$LATEST" != "$REQUESTED_SHA" ]]; then
+            echo "A newer shared commit ($LATEST) supersedes request for $REQUESTED_SHA"
+          fi
+          git -C shared/google-drive checkout --detach "$LATEST"
+          node --version
+          (cd shared/google-drive && npm test && npm run check)
+          python3 package.py
+          git config user.name 'github-actions[bot]'
+          git config user.email '41898282+github-actions[bot]@users.noreply.github.com'
+          git add shared/google-drive
+          if ! git diff --cached --quiet; then
+            git commit -m "build: pin PWA-GoogleDrive ${LATEST:0:12}"
+            git push origin HEAD:main
+          fi
+          echo "SHARED_SHA=$LATEST" >> "$GITHUB_ENV"
+      - name: Notify AppLauncher coordinator (explicitly; avoid implicit workflow chains)
+        env:
+          TOKEN: ${{ secrets.APP_LAUNCHER_DISPATCH_TOKEN }}
+          SHA: ${{ github.sha }}
+        shell: bash
+        run: |
+          set -euo pipefail
+          if [[ -z "$TOKEN" ]]; then echo '::error::Set APP_LAUNCHER_DISPATCH_TOKEN in Ciyan'; exit 1; fi
+          NEW_SHA="$(git rev-parse HEAD)"
+          jq -n --arg sha "$NEW_SHA" --arg shared "$SHARED_SHA" '{event_type:"ciyan-updated",client_payload:{app:"ciyan",sha:$sha,shared_sha:$shared}}' > /tmp/dispatch.json
+          curl --fail-with-body --silent --show-error --retry 3 -X POST \
+            -H "Authorization: Bearer $TOKEN" -H 'Accept: application/vnd.github+json' \
+            -H 'X-GitHub-Api-Version: 2022-11-28' --data-binary @/tmp/dispatch.json \
+            https://api.github.com/repos/tanner-voas/AppLauncher/dispatches
